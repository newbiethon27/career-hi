# OpenDART 인증키 — https://opendart.fss.or.kr 에서 무료 발급 (가입 즉시)
#
# scripts/fetch-dart.ts 에서만 사용된다. NEXT_PUBLIC_ 접두사를 붙이지 마라 —
# 붙이면 클라이언트 번들에 그대로 들어가 공개된다.
#
# 이 키가 없어도 앱은 정상 동작한다. data/companies.raw.json 에 수집된
# 스냅샷이 이미 커밋되어 있고, 런타임에는 외부 API를 호출하지 않는다.
# 회사 지표를 다시 수집할 때만 필요하다:
#
#   cp .env.local.example .env.local   # 그리고 아래에 키 입력
#   npm run fetch:dart
#
DART_API_KEY=

# ---- Supabase (회사 데이터) ----
# 대시보드 → Settings → API 의 Project URL / anon public 키.
# anon 키는 브라우저에 노출되도록 설계된 공개 키입니다. service_role 키는 절대 여기 넣지 마세요.
#
# 비워두면 앱은 data/*.json 으로 폴백하고 푸터에 그 사실을 표시합니다 (동작은 정상).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
